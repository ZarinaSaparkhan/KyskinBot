[Unit]
Description=KyskinBot Telegram bot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/kyskinbot/.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kyskinbot
Group=kyskinbot
WorkingDirectory=/opt/kyskinbot
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/kyskinbot/.venv/bin/python /opt/kyskinbot/deploy/preflight.py
ExecStart=/opt/kyskinbot/.venv/bin/python /opt/kyskinbot/bot.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/kyskinbot

[Install]
WantedBy=multi-user.target
