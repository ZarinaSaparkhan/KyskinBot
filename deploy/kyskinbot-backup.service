[Unit]
Description=Back up KyskinBot databases and configuration
ConditionPathExists=/opt/kyskinbot/.env

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /usr/local/libexec/kyskinbot-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/kyskinbot
